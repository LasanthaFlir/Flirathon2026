<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />

    <!--
        A RecognitionService must be able to see ANY calling app in order to
        validate its RECORD_AUDIO permission during #startListening — the
        caller package is not known ahead of time. Without this, Android's
        package-visibility filtering hides the caller from this process
        (AppsFilter logs "... -> <caller> BLOCKED"), and the framework's
        internal permission preflight then treats the caller as unpermitted,
        surfacing as SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS even
        though the caller actually holds RECORD_AUDIO. This is the standard
        "core functionality" exemption for apps that are themselves a system
        speech-recognition service provider.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.QnnWhistleKotlin"
        android:extractNativeLibs="true">

        <!--
            No <uses-library> for libcdsprpc.so needed here: unlike the QNN
            apps, Whistle (Cactus-Compute's needle engine) runs entirely on
            the ARM CPU — no Hexagon DSP / FastRPC access is involved.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.qnnwhistle.action.ACTIVITY_START_MIC" />
                <action android:name="com.example.qnnwhistle.action.ACTIVITY_STOP_MIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.qnnwhistle.action.TRANSCRIBE_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <!-- Same action without a data scheme (some callers may pass the
                 URI only via EXTRA_STREAM and leave intent.data null). -->
            <intent-filter>
                <action android:name="com.example.qnnwhistle.action.TRANSCRIBE_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Invisible trampoline activity for headless external callers.
             Uses the system Theme.Translucent.NoTitleBar so the caller's UI
             stays visible. NOT an alias of MainActivity — it has its own
             tiny class (TransparentLauncherActivity) that just forwards the
             intent to TranscriptionService and finishes. -->
        <activity
            android:name=".TransparentLauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.example.qnnwhistle.action.ACTIVITY_START_MIC" />
                <action android:name="com.example.qnnwhistle.action.ACTIVITY_STOP_MIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.qnnwhistle.action.TRANSCRIBE_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.qnnwhistle.action.TRANSCRIBE_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".MainActivity" />

        <!--
            Public standard speech-recognition entry point via
            RecognizerIntent.ACTION_RECOGNIZE_SPEECH. Any app can call
            startActivityForResult(Intent("android.speech.action.RECOGNIZE_SPEECH"))
            and receive EXTRA_RESULTS in onActivityResult. This sidesteps the
            Android-14 AttributionSource limitation that breaks the
            SpeechRecognizer binder API for 3rd-party callers.
        -->
        <activity
            android:name=".VoiceRecognitionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <action android:name="android.speech.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".TranscriptionService"
            android:exported="true"
            android:foregroundServiceType="microphone|dataSync">
            <intent-filter>
                <action android:name="com.example.qnnwhistle.action.START_LISTENING" />
                <action android:name="com.example.qnnwhistle.action.STOP_LISTENING" />
                <action android:name="com.example.qnnwhistle.action.TRANSCRIBE_FILE_BG" />
            </intent-filter>
        </service>

        <service
            android:name=".WhistleRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>
    </application>

</manifest>
